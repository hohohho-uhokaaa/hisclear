<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- 単一ファイル化の設定 -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="messages.ini" CopyToPublishDirectory="PreserveNewest" />
    <None Update="default_history.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="InstallPublishedFiles" AfterTargets="Publish">
    <PropertyGroup>
      <UserLocalBin>$(HOME)/.local/bin</UserLocalBin>
      <UserConfigDir>$(HOME)/.config/hisclear</UserConfigDir>
    </PropertyGroup>

    <MakeDir Directories="$(UserLocalBin);$(UserConfigDir)" />

    <Copy
      SourceFiles="$(PublishDir)$(AssemblyName)"
      DestinationFiles="$(UserLocalBin)/hisclear"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(PublishDir)messages.ini;$(PublishDir)default_history.txt"
      DestinationFolder="$(UserConfigDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>